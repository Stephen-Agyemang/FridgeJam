rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public mini-game leaderboard.
    // Anyone can read the top scores, and anyone can submit a score, but every
    // submission is validated so the collection can't be used as arbitrary
    // storage, spammed with junk, or stuffed with absurd values.
    match /game_scores/{scoreId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(
          ['nickname', 'score', 'gameType', 'missesLimit', 'createdAt']
        )
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 18
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.gameType == 'catch-ingredients'
        && request.resource.data.missesLimit is int
        && request.resource.data.createdAt == request.time;

      // Scores are immutable once written.
      allow update, delete: if false;
    }

    // Everything else stays locked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
