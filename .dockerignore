# Secrets — never bake into the image (Cloud Run injects env vars at runtime)
**/.env
**/.env.*
!**/.env.example

# Python virtualenvs & caches
**/.venv
**/__pycache__
**/*.pyc

# Tests & dev-only tooling (not needed at runtime)
backend/tests
backend/requirements-dev.txt

# Git & CI
.git
.github
.gitignore

# Firebase / deploy config (used by `firebase deploy`, not inside the container)
.firebase
firebase-debug.log
.firebaserc
firebase.json
firestore.rules

# Docs & non-runtime assets
*.md
scratch
submission-assets
reference

# OS junk
**/.DS_Store
